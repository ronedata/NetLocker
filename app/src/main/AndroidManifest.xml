<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to build the local VPN tunnel that is the only non-root,
         non-Shizuku way for a third-party app to observe/gate other apps'
         network traffic. See README "Why VPN?" for the Android security
         model justification. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ requires runtime consent to show the "firewall active"
         persistent notification. Requested explicitly, never silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to enumerate ALL installed apps (not just ones that declare
         an intent NetLocker queries for). This is a Google Play "sensitive
         permission" requiring a declaration form; documented in README. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- NetLocker isn't on Play Store (see README §9), so its own "Check for updates"
         (Settings) downloads and installs new versions itself via the normal system
         Package Installer — this permission only lets it ask; the user still sees and
         must approve the system's real install confirmation screen every time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the optional "Start when phone turns on" setting restart the firewall after a
         reboot. It does nothing unless the user switched that setting on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the App Details screen show how much data an app used today (Android's own
         network statistics). "Usage access" is a special permission the user grants in
         system Settings; it is only requested when they open that card's button. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets Settings' "Battery optimization" card show the real system dialog asking to
         exempt NetLocker from Doze/App Standby — a normal, auto-granted permission; it
         only lets the app ask, the user still approves (or declines) the system's own
         dialog every time it's shown. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".NetLockerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetLocker"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NetLocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The local firewall tunnel. BIND_VPN_SERVICE is a system-signature
             permission that only the OS itself holds and grants at runtime
             through the VpnService consent dialog (Activity.startActivityForResult
             on VpnService.prepare()) — the app never needs to hold it. -->
        <service
            android:name=".network.NetLockerVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local on-device firewall: enforces per-app Wi-Fi/mobile data rules the user configured." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile to turn the firewall on/off from the notification shade. -->
        <service
            android:name=".tile.FirewallTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_firewall"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".network.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
