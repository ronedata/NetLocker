<?xml version="1.0" encoding="utf-8"?>
<!-- NetLocker's real brand gradient (see ui/theme/Theme.kt primary/tertiary) — the same
     blue-to-cyan diagonal used for the in-app header badge, so the launcher icon actually
     matches the app instead of the unrelated dark-green placeholder it replaced. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#2F7BFF"
                android:endColor="#22D3EE" />
        </aapt:attr>
    </path>
</vector>
